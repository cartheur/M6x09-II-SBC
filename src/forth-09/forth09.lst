2587 f179 f1 7b                    PKEY    FDB   *+2
2588 f17b b6 98 00           [ 5 ] PKEY1   LDA   ACIAC          ; Get control status of the ACIA
2589 f17e 47                 [ 2 ]         ASRA                 ; Check if buffer is empty
2590 f17f 24 fa              [ 3 ]         BCC   PKEY1          ; If so, wait
2591 f181 f6 98 01           [ 5 ]         LDB   ACIAD          ; Get data
2592 f184 4f                 [ 2 ]         CLRA
2593 f185 36 06              [ 7 ]         PSHU  D              ; Push character to the stack
2594 f187 ae a1              [ 8 ]         LDX   ,Y++           ; NEXT
2595 f189 6e 91              [ 9 ]         JMP   [,X++]
2596                               
2597 f18b f1 8d                    PQTER   FDB   *+2
2598 f18d b6 98 00           [ 5 ]         LDA   ACIAC          ; Get control status of the ACIA
2599 f190 47                 [ 2 ]         ASRA                 ; Check if buffer is empty
2600 f191 24 08              [ 3 ]         BCC   PQTER1         ; If so push ZERO flag
2601 f193 f6 98 01           [ 5 ]         LDB   ACIAD          ; If not, get key
2602 f196 4f                 [ 2 ]         CLRA
2603 f197 36 06              [ 7 ]         PSHU  D
2604 f199 20 05              [ 3 ]         BRA   PQTER2         ; Go do NEXT
2605 f19b cc 00 00           [ 3 ] PQTER1  LDD   #0
2606 f19e 36 06              [ 7 ]         PSHU  D              ; Push flag
2607 f1a0 ae a1              [ 8 ] PQTER2  LDX   ,Y++           ; NEXT
2608 f1a2 6e 91              [ 9 ]         JMP   [,X++]
2609                               
2610 f1a4 f1 a6                    PEMIT   FDB   *+2
2611 f1a6 37 06              [ 7 ]         PULU  D              ; Character in B register
2612 f1a8 c4 7f              [ 2 ]         ANDB  #$7F           ; Mask off the highest bit
2613 f1aa b6 98 00           [ 5 ] PEMIT1  LDA   ACIAC          ; Get ACIA status
2614 f1ad 47                 [ 2 ]         ASRA                 ; Check if ready to transmit
2615 f1ae 47                 [ 2 ]         ASRA
2616 f1af 24 f9              [ 3 ]         BCC   PEMIT1         ; Loop if not ready
2617 f1b1 f7 98 01           [ 5 ]         STB   ACIAD          ; Transmit character
2618 f1b4 ae a1              [ 8 ]         LDX   ,Y++           ; NEXT
2619 f1b6 6e 91              [ 9 ]         JMP   [,X++]
