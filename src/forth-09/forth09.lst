3211 f5e1 f5 e3                    EECSTO  FDB   *+2            ; On entry Address is top of stack, Data is second
3212 f5e3 ec 42              [ 6 ]         LDD   2,U            ; Get byte in B, address is top of stack
3213 f5e5 86 ff              [ 2 ]         LDA   #$FF           ; Erase byte
3214 f5e7 a7 d4              [ 7 ]         STA   [0,U]
3215 f5e9 8d 0e              [ 7 ]         BSR   DELAY          ; Wait for delay
3216 f5eb a6 d4              [ 7 ]         LDA   [0,U]          ; Read data
3217 f5ed e7 d4              [ 7 ]         STB   [0,U]          ; Store data
3218 f5ef 8d 08              [ 7 ]         BSR   DELAY          ; Wait for delay
3219 f5f1 e6 d4              [ 7 ]         LDB   [0,U]          ; Read data
3220 f5f3 33 44              [ 5 ]         LEAU  4,U            ; Drop address and data
3221 f5f5 ae a1              [ 8 ]         LDX   ,Y++           ; NEXT
3222 f5f7 6e 91              [ 9 ]         JMP   [,X++]
